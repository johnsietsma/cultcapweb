---
import Landing from "../layouts/Landing.astro";

const title = "CultCap";
const description =
	"3D capture for museum objects, from a phone. No scanner, no studio, no specialist.";

const buttondownUser = "cultcap";
---

<Landing title={title} description={description}>
	<main class="mx-auto flex max-w-3xl flex-col gap-12 px-6 py-16">
		<header class="flex items-center gap-3">
			<img src="/favicon.svg" alt="" width="36" height="36" />
			<span class="text-lg font-semibold tracking-tight">CultCap</span>
		</header>

		<section class="flex flex-col gap-6">
			<h1 class="text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
				3D capture for museum objects, from a phone.
			</h1>
			<p class="max-w-2xl text-lg text-[var(--muted)]">
				Walk around an object with your phone. CultCap turns the photos into a 3D model you
				can put online. No scanner, no studio, no specialist. It's for small museums,
				galleries and historical societies with more objects than budget.
			</p>
		</section>

		<section class="flex flex-col gap-4 rounded-lg border border-black/10 bg-white/60 p-6">
			<h2 class="text-xl font-semibold">Hear when there's something to see</h2>
			<p class="text-[var(--muted)]">
				I'm building this in the open, one object at a time. I'll email when there's a new
				capture worth looking at, a few times a year, and never anything else.
			</p>
			<form
				action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUser}`}
				method="post"
				class="flex flex-col gap-3 sm:flex-row"
			>
				<label class="sr-only" for="bd-email">Email address</label>
				<input
					id="bd-email"
					name="email"
					type="email"
					required
					placeholder="you@example.org"
					class="flex-1 rounded border border-black/20 bg-white px-4 py-2"
				/>
				<button
					type="submit"
					class="rounded bg-[var(--accent)] px-5 py-2 font-medium text-white"
				>
					Keep me posted
				</button>
			</form>
		</section>

		<footer class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-[var(--muted)]">
			<span>Made in Newcastle, Australia by John Sietsma.</span>
			<a class="underline" href="https://johnsietsma.com/posts/cultcap-why-im-doing-this/"
				>Why I'm doing this</a
			>
			<a class="underline" href="https://johnsietsma.com/tags/cultcap/">Progress notes</a>
		</footer>
	</main>
</Landing>
